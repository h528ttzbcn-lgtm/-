# Amazon SP-API credentials
# See README.md "SP-API 認証情報の取得手順" for how to obtain each value.

# LWA (Login with Amazon) app credentials, created in Seller Central > Apps & Services > Develop apps
LWA_APP_ID=
LWA_CLIENT_SECRET=

# Refresh token issued when you authorize your app against your own seller account
SP_API_REFRESH_TOKEN=

# Optional: only required if your app still uses the legacy IAM-role auth flow.
# Most self-authorized apps created after 2023 do not need these.
SP_API_AWS_ACCESS_KEY=
SP_API_AWS_SECRET_KEY=
SP_API_ROLE_ARN=

# Optional here: Catalog Items / Product Pricing (read-only) don't require a
# seller ID, unlike amazon_auto_listing's Listings Items API calls.
SP_API_SELLER_ID=

# Marketplace to operate against. One of the keys defined in sp_api.base.Marketplaces,
# e.g. JP, US, DE, UK, FR, IT, ES, CA, MX, IN, AU ...
SP_API_MARKETPLACE=JP

# Optional: Keepa API key (https://keepa.com/#!api) for Keepa-style trailing
# average price/sales-rank stats. Leave empty to use SP-API only.
KEEPA_API_KEY=
KEEPA_DOMAIN=JP
