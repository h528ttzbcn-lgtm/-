# Shopee Open Platform credentials
# See README.md "Shopee API 認証情報の取得手順" for how to obtain each value.

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# Obtained via the OAuth authorization flow (see `authorize` / `exchange-token`
# CLI commands). Access tokens expire (~4h); refresh with `refresh-token`.
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=

# Live: https://partner.shopeemobile.com
# Sandbox/test: https://partner.test-stable.shopeemobile.com
SHOPEE_API_HOST=https://partner.shopeemobile.com

# Where your app's OAuth redirect points back to (must match the app's
# registered redirect URL in Shopee Open Platform).
SHOPEE_REDIRECT_URL=http://localhost:8765/callback
