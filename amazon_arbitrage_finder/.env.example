# ---- 楽天ウェブサービス (楽天市場商品検索API) ----
# https://webservice.rakuten.co.jp/ でアプリを登録して取得。
# 2026年の刷新以降は applicationId と accessKey の両方が必須です。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# アプリ登録時に「許可されたWebサイト」として登録したURL。Refererヘッダとして送信されます。
RAKUTEN_REFERER=
# APIバージョンが更新されたらここを差し替えてください(README参照)。
RAKUTEN_ENDPOINT=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260701

# ---- Yahoo!ショッピング 商品検索API (v3) ----
# https://e.developer.yahoo.co.jp/ でアプリを登録し Client ID を取得。
YAHOO_CLIENT_ID=
YAHOO_ENDPOINT=https://shopping.yahooapis.jp/ShoppingWebService/V3/itemSearch

# ---- Amazon SP-API (amazon_auto_listing と同じ値でOK) ----
# ロールは最低限 Product Listing と Pricing が必要です。
LWA_APP_ID=
LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_AWS_ACCESS_KEY=
SP_API_AWS_SECRET_KEY=
SP_API_ROLE_ARN=
SP_API_SELLER_ID=
SP_API_MARKETPLACE=JP
